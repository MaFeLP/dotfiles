# Maintainer: MaFeLP <mafelp@proton.me>
pkgname='zsh-config'
pkgver='1.0.7'
pkgrel='1'
pkgdesc='My personal ZSH configurations'
arch=('any')
url='https://github.com/mafelp/dotfiles'
license=('GPL3')
depends=(
  'starship'
  'thefuck'
  'z'
  'zsh'
  'zsh-autosuggestions'
  'zsh-completions'
  'zsh-syntax-highlighting'
)
makedepends=()
source=("files.tar.gz")
sha256sums=("c71cb75fb4e39773e42ecb1fc3b449bf232274db7dffb3b63eff083fa1637544")
install="${pkgname}.install"

prepare() {
  cd "${srcdir}/files"

  # Prepare the normal environment file for systemd
  cp zshenv environment
  sd '^export ' '' environment   # remove the export at the start of lines
  sd '^#.*$' '' environment      # remove comments
  sed -i '/^\s*$/d' environment  # remove blank lines
}

package() {
  cd "${srcdir}/files"

  # ZSH configs
  for f in zsh/*;do
    install -Dm644 $f "${pkgdir}/etc/zsh/custom/$(basename "$f")"
  done

  # Enables environment variables in tty
  install -Dm644 zshenv "${pkgdir}/etc/zsh/zshenv"
  install -Dm644 environment "${pkgdir}/etc/zsh/systemd_environment.env"

  install -Dm644 starship.toml "${pkgdir}/etc/starship.toml"
  install -Dm644 zshrc "${pkgdir}/etc/zsh/zshrc"
}

